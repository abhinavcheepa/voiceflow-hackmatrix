# VoiceFlow AI Environment Configuration
# Copy this file to .env and fill in your values. Never commit real keys.

# ═══ ENVIRONMENT & AUTHENTICATION ═══════════════════════════════════════
# Environment mode: 'development' allows unauthenticated local access if API_TOKEN is empty.
# 'production' strictly enforces authentication and requires API_TOKEN to be set.
ENV=development

# Master Bearer token required for all /api/* routes and SSE tickets.
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(24))"
API_TOKEN=

# Shared secret between the local WhatsApp Web bridge (wa-bridge) and the backend.
# Sent in the X-Bridge-Token header for /api/whatsapp/web/incoming.
BRIDGE_SECRET=

# Allowed origins for CORS (comma-separated).
CORS_ORIGINS=http://localhost:5174,http://localhost:5173,https://localhost

# Domain for Caddy automated HTTPS reverse proxy (e.g. voiceflow.yourdomain.com)
DOMAIN=localhost

# ═══ WEB PUSH (VAPID) ═══════════════════════════════════════════════════
# Generates mobile push notifications for calls and WhatsApp messages.
# Generate keys with: python -m push generate-keys (or run in backend/)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:admin@example.com

# ═══ CALLS & TELEPHONY — Vapi ════════════════════════════════════════════
# Vapi API private key for automated voice calls (https://vapi.ai)
VAPI_PRIVATE_KEY=
# Secret string configured in Vapi webhook settings; checked via X-Vapi-Secret header.
VAPI_WEBHOOK_SECRET=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=

# ═══ WHATSAPP AUTOMATION ═════════════════════════════════════════════════
# Provider: 'web' (local wa-bridge WhatsApp Web) or 'meta' (official Cloud API)
WHATSAPP_PROVIDER=web

# wa-bridge connection settings
WA_BRIDGE_URL=http://wa-bridge:8100
WA_BRIDGE_TOKEN=

# Meta Cloud API settings (only when WHATSAPP_PROVIDER=meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ═══ SPEECH & VOICE (TTS & STT) ══════════════════════════════════════════
# Voice synthesis provider: 'edge' (free, 21 Indian voices) or 'cartesia' (voice cloning)
VOICE_PROVIDER=edge
CARTESIA_API_KEY=
VOICE_LANGUAGE=hi

# Speech-to-text: 'auto' (Groq Whisper if key present, else local faster-whisper)
STT_PROVIDER=auto
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3

# ═══ REPLIES & LLM BRAIN ═════════════════════════════════════════════════
# Any OpenAI-compatible chat API (Groq, NVIDIA NIM, OpenAI, OpenRouter)
CHAT_MODEL=openai/gpt-oss-120b
CHAT_BASE_URL=
CHAT_API_KEY=

# ═══ ASTERISK PBX (Optional) ═════════════════════════════════════════════
ASTERISK_ARI_URL=
ASTERISK_ARI_USERNAME=voiceflow
ASTERISK_ARI_PASSWORD=
ASTERISK_ARI_APP=voiceflow-ai
VAPI_SIP_URI=

# ═══ PUBLIC REACHABILITY & STORAGE ═══════════════════════════════════════
# Public HTTPS URL of the server where webhooks are delivered
PUBLIC_URL=
DB_PATH=/data/voiceflow.db
