# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
# Nothing here is needed to start the server. Each integration switches on when
# its keys are present; GET /health tells you which ones are live.

# ═══ CALLS — Vapi ════════════════════════════════════════════════════════
# Runs the realtime voice loop (STT -> LLM -> cloned-voice TTS) on phone calls.
# vapi.ai -> Settings -> API Keys -> Private Key
VAPI_PRIVATE_KEY=

# Any random string you invent. Set the SAME value in Vapi under your
# assistant's Server URL settings. Vapi echoes it back as the X-Vapi-Secret
# header so the webhook can reject forged requests.
VAPI_WEBHOOK_SECRET=

# Leave blank to use the assistant defined in backend/vapi.py (recommended —
# it's version-controlled). Set only to use one built in Vapi's dashboard.
VAPI_ASSISTANT_ID=

# Only if you rent a number from Vapi. Our own PBX doesn't need it.
VAPI_PHONE_NUMBER_ID=

# ═══ WHATSAPP ════════════════════════════════════════════════════════════
# Which provider to use:
#   meta = official Cloud API. Needs business KYC, fully within WhatsApp's
#          terms, no ban risk.
#   web  = the local wa-bridge driving WhatsApp Web. No KYC, works with an
#          ordinary number in minutes — but it is against WhatsApp's terms and
#          numbers do get banned. Use a dedicated SIM, never a personal one.
WHATSAPP_PROVIDER=meta

# ─── if WHATSAPP_PROVIDER=web ────────────────────────────────────────────
# Start the bridge with: cd wa-bridge && npm install && npm start
# Then scan the QR from the dashboard or the terminal.
WA_BRIDGE_URL=http://127.0.0.1:8100
# Any random string. Set the SAME value as BRIDGE_TOKEN when starting the
# bridge — it is what stops anything else on the machine sending messages.
WA_BRIDGE_TOKEN=

# ─── if WHATSAPP_PROVIDER=meta ───────────────────────────────────────────
# developers.facebook.com -> your app -> WhatsApp -> API Setup
# Use a permanent System User token, not the 24-hour temporary one.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Any random string you invent. Paste the same value into Meta ->
# WhatsApp -> Configuration -> Webhook -> Verify token.
WHATSAPP_VERIFY_TOKEN=

# ═══ VOICE ═══════════════════════════════════════════════════════════════
# edge     = Microsoft Edge TTS. Free, no key, no quota, 21 Indian voices.
#            The default — leave it alone unless you need cloning.
# cartesia = better prosody and the only provider that can clone a voice,
#            but the free tier runs out after a few dozen replies (402).
VOICE_PROVIDER=edge

# Speaking speed and pitch. Voice Studio writes these too; .env is the value
# used before anyone touches the sliders.
VOICE_RATE=+15%
VOICE_PITCH=+0Hz

# play.cartesia.ai -> API Keys. Only needed when VOICE_PROVIDER=cartesia.
# For phone calls, also paste this key into Vapi -> Provider Keys.
CARTESIA_API_KEY=

# Optional: a voice id to use before one is picked in Voice Studio.
VOICE_ID=
CARTESIA_MODEL=sonic-3.5
CARTESIA_VERSION=2026-03-01

# ISO 639-1 code the voice is cloned in, and the fallback for synthesis.
VOICE_LANGUAGE=hi

# ═══ TRANSCRIPTION — Groq or local ═══════════════════════════════════════
# auto  = use Groq if its key is set, otherwise run locally (default)
# groq  = hosted Whisper. Fastest. Needs GROQ_API_KEY.
# local = faster-whisper on CPU. No key, no bill, nothing leaves the machine.
#         Downloads the model (~460 MB for "small") on first voice note.
STT_PROVIDER=auto

# Free Groq API key: https://console.groq.com/keys (reused for Groq STT and chat replies)
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3

# tiny | base | small | medium | large-v3 — bigger is better and slower. Default: base
WHISPER_MODEL=base
WHISPER_COMPUTE=int8
LOCAL_STT_MODEL=base

# ═══ REPLIES — any OpenAI-compatible chat API ════════════════════════════
# Leave blank to reuse GROQ_API_KEY above.
# Free alternative (NVIDIA NIM): https://build.nvidia.com (free API credits)
#   CHAT_BASE_URL=https://integrate.api.nvidia.com/v1
#   CHAT_API_KEY=nvapi-...
#   CHAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b
CHAT_BASE_URL=
CHAT_API_KEY=
# Hosted models are retired with little warning, and the symptom is every reply
# failing with a 404. Check what is live before debugging anything else:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
CHAT_MODEL=openai/gpt-oss-120b

# ─── reply failover (keeps calls alive through provider outages) ──────────
# Replies try providers in order and use the first that answers, so a retired
# model or a provider outage degrades instead of dropping the reply.
#   1. CHAT_MODEL above (primary)
#   2. a second Groq model, same key — catches model retirement + rate limits
CHAT_FALLBACK_MODEL=openai/gpt-oss-20b
#   3. a DIFFERENT provider, for when Groq itself is down. Any OpenAI-compatible
#      free API works. NVIDIA NIM is free — get an nvapi- key at build.nvidia.com,
#      then set all three below (OpenRouter / Cerebras work the same way):
#   FALLBACK_BASE_URL=https://integrate.api.nvidia.com/v1
#   FALLBACK_API_KEY=nvapi-...
#   FALLBACK_MODEL=meta/llama-3.3-70b-instruct
FALLBACK_BASE_URL=
FALLBACK_API_KEY=
FALLBACK_MODEL=

# ═══ TELEPHONY — Asterisk (Phases 1-5) ═══════════════════════════════════
# Leave ASTERISK_ARI_URL blank and the backend starts normally without it.
# Must match [voiceflow] in asterisk/ari.conf.
ASTERISK_ARI_URL=http://127.0.0.1:8088/ari
ASTERISK_ARI_USERNAME=voiceflow
ASTERISK_ARI_PASSWORD=
ASTERISK_ARI_APP=voiceflow-ai

# What the caller hears on answer. "sound:hello-world" ships with Asterisk.
ASTERISK_GREETING=sound:hello-world

# Where the audio leg goes for the actual conversation. Blank = Phase 1-5 mode:
# greet, then hang up. Set this once the Vapi SIP endpoint is registered.
#   VAPI_SIP_URI=PJSIP/voiceflow@vapi
VAPI_SIP_URI=

MAX_CALL_SECONDS=1800

# ═══ REACHABILITY ════════════════════════════════════════════════════════
# Public HTTPS base URL of THIS backend, no trailing slash. Both Vapi and Meta
# post webhooks here. In development: `ngrok http 8000` and paste the https URL.
#   Vapi   -> <PUBLIC_URL>/api/vapi/webhook
#   Meta   -> <PUBLIC_URL>/api/whatsapp/webhook
PUBLIC_URL=

# ═══ PERSONA ═════════════════════════════════════════════════════════════
BUSINESS_NAME=VoiceFlow Demo
OWNER_NAME=Abhinav

# Owner assistant ("Jarvis" mode on the Web call page) can message any number,
# so from any device other than this computer — e.g. your phone on the same
# Wi-Fi — it asks for this PIN. Leave blank to allow it on this computer only.
ASSISTANT_PIN=
# Optional: a phone number the Vapi agent can transfer a stuck call to. Leave
# blank and the transfer-to-human tool is simply not offered.
OWNER_PHONE=

# ═══ LOCAL ═══════════════════════════════════════════════════════════════
VAPI_BASE_URL=https://api.vapi.ai
WHATSAPP_API_VERSION=v21.0
DATABASE_PATH=voiceflow.db
CORS_ORIGINS=http://localhost:5174

# ??? WEBCALL GATE & SECURITY ?????????????????????????????????????????????
# Public browser-based voice calls (/api/web-call/*). Defaults to true.
WEBCALL_PUBLIC=true

# Demo day mode: raises limits for live presentations (defaults to false).
# When true: global budget 300m, per-IP budget 30m, 50 calls / 10 min.
WEBCALL_DEMO_MODE=false

# Global daily budget in minutes (default: 120.0, demo: 300.0).
DAILY_WEBCALL_MINUTES_BUDGET=120.0

# Per-IP daily budget in minutes (default: 15.0, demo: 30.0, strictly below global).
WEBCALL_PER_IP_DAILY_MINUTES=15.0

# Sliding-window rate limit per IP (default: 5 calls / 600s, demo: 50).
WEBCALL_RATE_LIMIT_PER_IP=5
WEBCALL_WS_CONNECT_RATE_LIMIT_PER_IP=5
WEBCALL_RATE_LIMIT_WINDOW_SECONDS=600

# Concurrency and timeout caps
MAX_CONCURRENT_WEBCALLS=10
MAX_WEBCALL_DURATION_SECONDS=300
WEBCALL_IDLE_TIMEOUT_SECONDS=60

# Reverse proxies / tunnels trusted to supply real client IPs in X-Forwarded-For.
# Supports comma-separated IP addresses or CIDR notations.
# Default if blank: loopback only (127.0.0.1/32, ::1/128).
# Examples:
#   For local ngrok/Caddy on host: 127.0.0.1/32,::1/128
#   For Docker Compose (Caddy bridge network): 172.16.0.0/12,127.0.0.1/32
TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Allowed Origin headers for WebSocket connections (blank allows all).
ALLOWED_ORIGINS=
